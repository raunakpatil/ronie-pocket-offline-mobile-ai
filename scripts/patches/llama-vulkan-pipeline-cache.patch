+// Ronie Pocket: writes each device's pipeline cache to its GGML_VK_PIPELINE_CACHE file (atomically).
+static void ggml_backend_vk_save_pipeline_cache() {
+    for (auto & d : vk_instance.devices) {
+        if (!d || !d->pipeline_cache || d->pipeline_cache_path.empty()) continue;
+        try {
+            std::vector<uint8_t> data = d->device.getPipelineCacheData(d->pipeline_cache);
+            const std::string tmp = d->pipeline_cache_path + ".tmp";
+            if (FILE * f = fopen(tmp.c_str(), "wb")) {
+                const bool ok = fwrite(data.data(), 1, data.size(), f) == data.size();
+                fclose(f);
+                if (ok) rename(tmp.c_str(), d->pipeline_cache_path.c_str());
+            }
+        } catch (...) {}
+    }
+}
