# Gradle / Android
.gradle/
build/
local.properties
keystore.properties
*.jks
*.keystore
.cxx/
.externalNativeBuild/
.kotlin/
captures/
*.apk
*.aab

# IDE
.idea/
*.iml
.vscode/

# Python tooling
tools-pc/.venv/
__pycache__/
*.pyc

# Models and data (never commit weights or personal data)
models-local/
*.gguf
*.onnx
*.safetensors
*.zim
tools-pc/data/private/
eval/private/

# Local temp
.gradle-tmp/

# Third-party sources (cloned, pinned by commit in docs)
third_party/

# PC-side prebuilt binaries
tools-pc/bin/

# Local llama-server logs from bake-off runs
eval/results/server-*.log

# Prebuilt llama.cpp engine libraries (produced by scripts\build-engine-libs.cmd)
core/engine/prebuilt/
core/engine/src/main/jniLibs/

# Prebuilt stable-diffusion.cpp engine libraries (produced by scripts\build-sd-libs.cmd)
core/imagegen/prebuilt/
core/imagegen/src/main/jniLibs/

# NSFW stress-test outputs contain explicit text; keep them local only
eval/results/*nsfw*

# X-ray data is regenerated by eval/xray/make_data.py (seeded); activations stay on Modal
eval/xray/data_*.jsonl
eval/xray/own_raw.jsonl
eval/xray/*.bin
eval/xray/*.bin.json
!app/src/main/assets/voice/paradee_int8.onnx
!app/src/main/assets/memory/bge-small-int8.onnx

# Persona state: generated by scripts\make-persona-state.cmd (18 MB, changes with the prompt)
app/src/main/assets/state/

# Local experiments, phone screenshots and bake-off output (large or personal; not for the repo)
eval/nitro_e/
eval/bakeoff/
eval/*.png
ui_dump.xml
